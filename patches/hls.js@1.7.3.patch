diff --git a/dist/hls.mjs b/dist/hls.mjs
index fce9ba311355708eaf3846cc9f167a1fdd946c76..1f0a53ed3a4a96665632c32c1fe4368bbd91b267 100644
--- a/dist/hls.mjs
+++ b/dist/hls.mjs
@@ -10863,7 +10863,12 @@ class BaseStreamController extends TaskLoop {
         }
         if ('data' in reason) {
           reason.data.frag = mediaFrag;
-          this.fragmentLoader.abort();
+          // CommonAir patch: abort only this fragment's own load. If a later fragment is current (an
+          // EXT-X-GAP start fragment whose shared init load the next fragment aborted), its request
+          // would be cancelled, and before the first parse nothing resets FRAG_LOADING: a stuck player.
+          if (!this.fragContextChanged(mediaFrag)) {
+            this.fragmentLoader.abort();
+          }
           this.handleFragLoadError(reason);
         }
         this.resetFragmentLoading(mediaFrag);
