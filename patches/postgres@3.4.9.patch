diff --git a/cjs/src/connection.js b/cjs/src/connection.js
index 07f6716702ac888215c86ad6e0071aaf55ae519c..4013586637f113a9fc3217bbc30979aabd45e014 100644
--- a/cjs/src/connection.js
+++ b/cjs/src/connection.js
@@ -163,6 +163,11 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (q.cancelled)
       return
 
+    // CommonAir patch: a reserved or transaction handle can still execute on a connection whose
+    // socket closed; writing would throw from a timer (uncaught). Reject the query instead.
+    if (!socket)
+      return queryError(q, Errors.connection('CONNECTION_CLOSED', options)), true
+
     try {
       q.state = backend
       query
@@ -252,6 +257,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function nextWrite(fn) {
+    // CommonAir patch: never throw from the setImmediate flush after the socket is gone.
+    if (!socket)
+      return (chunk = nextWriteTimer = null, false)
     const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
@@ -438,6 +446,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    // CommonAir patch: drop the unsent chunk, or the next session's startup is prefixed with it
+    // and write() never schedules a flush (nextWriteTimer stays set).
+    chunk = nextWriteTimer = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
diff --git a/cjs/src/index.js b/cjs/src/index.js
index f09c61c7e998f411560b95c9a8e1ed6a97972c11..258ffeea6275f940c93e12c245ec5f734f37c26c 100644
--- a/cjs/src/index.js
+++ b/cjs/src/index.js
@@ -236,13 +236,14 @@ function Postgres(a, b) {
     const queries = Queue()
     let savepoints = 0
       , connection
+      , closedError = null
       , prepare = null
 
     try {
       await sql.unsafe('begin ' + options.replace(/[^a-z ]/ig, ''), [], { onexecute }).execute()
       return await Promise.race([
         scope(connection, fn),
-        new Promise((_, reject) => connection.onclose = reject)
+        new Promise((_, reject) => connection.onclose = e => reject(closedError = e))
       ])
     } catch (error) {
       throw error
@@ -290,6 +291,11 @@ function Postgres(a, b) {
 
       function handler(q) {
         q.catch(e => uncaughtError || (uncaughtError = e))
+        // CommonAir patch: once the transaction's connection closed, the pool may reconnect the
+        // same connection object for another query; never run this transaction's later
+        // statements (or its commit) there in autocommit.
+        if (closedError)
+          return q.reject(closedError)
         c.queue === full
           ? queries.push(q)
           : c.execute(q) || move(c, full)
