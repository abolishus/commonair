# SPDX-FileCopyrightText: 2026 CommonAir contributors
# SPDX-License-Identifier: CC0-1.0
#
# CommonAir environment. Copy to `.env` with `bun scripts/init-env.ts`, which
# fills every secret below with fresh random values. Never commit `.env`.
# Every variable is validated at service startup (packages/config/src/env.ts).

# --- core ---
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
CHAT_PUBLIC_URL=ws://localhost:3002/ws
IRC_PUBLIC_HOST=localhost
INSTANCE_NAME=
INSTANCE_IS_FLAGSHIP=false
INSTANCE_DEFAULT_LOCALE=en
CONTACT_EMAIL=
SECURITY_EMAIL=
ABUSE_EMAIL=
DMCA_EMAIL=
PRIVACY_EMAIL=
NOREPLY_EMAIL=
SOURCE_URL=
SOURCE_COMMIT=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=
TRUSTED_PROXY_CIDRS=

# --- data ---
DATABASE_URL=postgres://commonair:commonair@localhost:5432/commonair
DATABASE_POOL_MAX=10
POSTGRES_APP_PASSWORD=__generate__
GOVERNANCE_BOOTSTRAP_JSON=
VALKEY_URL=redis://localhost:6379

# --- service-to-service ---
INTERNAL_API_SECRET=__generate__
API_INTERNAL_URL=http://localhost:3001
CHAT_INTERNAL_URL=ws://localhost:3002/ws
ORIGIN_INTERNAL_URL=http://localhost:3003

# --- object storage (Garage by default; any S3-compatible store works) ---
S3_ENDPOINT=http://localhost:3900
# Browsers' S3 endpoint for presigned uploads (empty: S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
# Public media (avatars, thumbnails, clips, VODs): the origin's /media route (ADR 0009).
MEDIA_PUBLIC_URL=http://localhost:3003/media
S3_REGION=garage
S3_ACCESS_KEY_ID=__generate__
S3_SECRET_ACCESS_KEY=__generate__
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=commonair-media
S3_BUCKET_EXPORTS=commonair-exports
S3_BUCKET_BACKUPS=commonair-backups
# Sealed T0 evidence (VOD/clip objects). Its own Garage key, worker only; the main key has no access.
S3_BUCKET_EVIDENCE=commonair-evidence
S3_EVIDENCE_ACCESS_KEY_ID=__generate__
S3_EVIDENCE_SECRET_ACCESS_KEY=__generate__

# --- auth ---
AUTH_SECRET=__generate__
AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_MIN_AGE=13
ALTCHA_HMAC_KEY=__generate__
# Optional OAuth providers. Leave blank to disable; operators turn each on by
# supplying credentials.
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_TWITCH_CLIENT_ID=
OAUTH_TWITCH_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- mail (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- payments: `manual` needs no vendor; `stripe` is test mode only ---
PAYMENTS_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_API_BASE=
# Must match the payout.rules governance setting's currency (the payout minimum lives there).
CURRENCY=usd
# Manual adapter texts ({reference} and {amount} are filled in); empty = built-in default.
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_PAYOUT_INSTRUCTIONS=
PAYMENT_PENDING_DAYS=7

# --- media ---
MEDIA_INTERNAL_PASSWORD=__generate__
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_SRT_URL=srt://localhost:8890
INGEST_RTMP_PUBLIC_URL=rtmp://localhost:1935/live
INGEST_WHIP_PUBLIC_URL=http://localhost:8889/live
TRANSCODE_VIEWER_THRESHOLD=50
TRANSCODE_HWACCEL=auto
MEDIA_WORK_DIR=
MEDIA_WORK_DIR_MAX_BYTES=21474836480
MEDIA_WORK_DIR_MIN_FREE_BYTES=2147483648
TRANSCODE_MAX_LADDERS=

# --- trust & safety (ADR 0006): the pipeline always runs; only providers are chosen ---
MODERATION_SAMPLE_SECONDS=10
# Optional host paths to operator hash-list files (one PDQ hex per line). Compose mounts them
# read-only; the database block list always loads.
MODERATION_HASHLIST_CSAM=
MODERATION_HASHLIST_NCII=
MODERATION_CLASSIFIER=onnx
# Optional host path to the verified model. Empty uses the `fetch-model.ts` default path.
MODERATION_CLASSIFIER_MODEL=
# Harness only. Never on a public instance.
MODERATION_TEST_HOOKS=false
# --- co-op (ADR 0020) ---
# Harness only. Never on a public instance: serves POST /internal/coop/tick.
COOP_TEST_HOOKS=false
# --- operations (ADR 0021) ---
# Harness only. Never on a public instance: serves POST /internal/ops/tick.
OPS_TEST_HOOKS=false
# --- interactivity (ADR 0026) ---
# Harness only. Never on a public instance: serves POST /internal/interact/tick.
INTERACT_TEST_HOOKS=false
# --- full-coverage seed (harness seed full) ---
# Local and staging only. Never on a real instance: allows the full seed and points on demo data.
DEMO_SEED_FULL=false
# --- chat (ADR 0012 amendment 1, ADR 0015) ---
# Verified-watch gate and surge guard: off until their GA criteria are met.
CHAT_WATCH_GATE=off
CHAT_SURGE_GUARD=off
# Chat kept 30 days, or with its VOD at most 60 days (CHAT_REPLAY_MAX_DAYS >= CHAT_RETENTION_DAYS).
CHAT_RETENTION_DAYS=30
CHAT_REPLAY_MAX_DAYS=60
# X25519 evidence keypair. Media, worker and API seal with the public key; only the API's legal
# view holds the private key. Keep an offline copy of the private key: sealed evidence cannot be
# read without it.
EVIDENCE_PUBLIC_KEY=__generate_x25519_public__
EVIDENCE_PRIVATE_KEY=__generate_x25519_private__

# --- playback ---
PLAYBACK_SIGNING_KEY=__generate_ed25519__
PLAYBACK_PUBLIC_URL=http://localhost:3003
P2P_ENABLED=true
# P2P for viewers who have not chosen: off (viewers opt in) until counsel confirms a lawful basis
# for showing a viewer's IP address to peers (ADR 0005 amendment 1).
P2P_DEFAULT=off
P2P_TRACKER_URL=ws://localhost:8000
CDN_PROVIDER=none
CDN_BASE_URL=
CDN_BURST_VIEWER_THRESHOLD=5000
ORIGIN_CACHE_MB=512
# Compute relay issuance on this origin (replicas elect one leader per tick).
ORIGIN_ISSUANCE_ENABLED=true

# --- tracker (services/tracker) ---
TRACKER_MAX_CONNECTIONS=20000
TRACKER_MAX_CONNECTIONS_PER_IP=20
TRACKER_MAX_NUMWANT=20
TRACKER_TOKEN_MAX_AGE_SECONDS=43200

# --- ICE servers for P2P (API only; coturn, STUN always, the TURN relay off by default) ---
P2P_STUN_URLS=stun:localhost:3478
# turn:/turns: URIs; empty keeps the relay off (a relayed peer's bytes cross the server twice).
P2P_TURN_URLS=
# TURN REST shared secret, also coturn's static-auth-secret; required when P2P_TURN_URLS is set.
TURN_SHARED_SECRET=__generate__
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- integrity ---
INTEGRITY_DATACENTER_CIDRS_FILE=

# --- developer platform ---
EVENTSUB_ALLOW_INSECURE_CALLBACKS=false
# EventSub WebSocket limits (ADR 0027): subscriptions per session, sessions per (app, user),
# seconds to subscribe after connecting, seconds the old socket lives after a reconnect.
EVENTSUB_WS_MAX_SUBSCRIPTIONS=300
EVENTSUB_WS_MAX_SESSIONS_PER_GRANT=3
EVENTSUB_WS_SUBSCRIBE_WITHIN_SECONDS=10
EVENTSUB_WS_RECONNECT_GRACE_SECONDS=30
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false

# --- notifications (ADR 0028) ---
# Browser push: off by default; each viewer still opts in per browser. init-env generates the
# VAPID pair (selfhost.sh --web-push turns push on).
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=__generate_vapid_public__
VAPID_PRIVATE_KEY=__generate_vapid_private__
# Harness only. Never on a public instance: accepts http:// and private-network push endpoints.
WEB_PUSH_ALLOW_INSECURE_ENDPOINTS=false

# --- worker ---
WORKER_CONCURRENCY=
WORKER_BULL_PREFIX=bull

# --- infrastructure (compose / Quadlet only) ---
POSTGRES_PASSWORD=__generate__
GARAGE_RPC_SECRET=__generate_hex64__
GARAGE_ADMIN_TOKEN=__generate__
GRAFANA_ADMIN_PASSWORD=__generate__
VALKEY_PASSWORD=__generate_hex64__
BIND_ADDRESS=127.0.0.1
PUBLIC_HOSTNAME=
TLS_MODE=acme
ACME_EMAIL=
ACME_CA=
IMAGE_REGISTRY=
IMAGE_TAG=
WALG_RETAIN_FULL=7
POSTGRES_MAX_CONNECTIONS=
COMPOSE_SUBNET=
COMMONAIR_ENV_FILE=
# coturn: listening port (STUN, and TURN when the relay is on), the relay's UDP range (relay only)
# and the one public address it advertises (empty: none).
TURN_PORT=3478
TURN_RELAY_PORT_MIN=49160
TURN_RELAY_PORT_MAX=49199
TURN_EXTERNAL_IP=

# --- ports ---
WEB_PORT=3000
API_PORT=3001
CHAT_PORT=3002
ORIGIN_PORT=3003
IRC_PORT=6667
IRC_TLS_PORT=6697
IRC_WS_PORT=6680
IRC_HEALTH_PORT=6681
MEDIA_PORT=3004
WORKER_PORT=3005
TRACKER_PORT=8000
IRC_TLS_CERT_FILE=
IRC_TLS_KEY_FILE=
IRC_TLS_ALLOW_SELF_SIGNED=false
# IRC gateway admission limits (per process; connection bucket per client address).
IRC_MAX_CONNECTIONS=20000
IRC_MAX_CONNECTIONS_PER_IP=50
IRC_CONNECT_BURST_PER_IP=20
IRC_CONNECT_PER_SECOND_PER_IP=2
