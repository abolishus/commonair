{
  "name": "@commonair/ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./globals.css": "./src/styles/globals.css",
    "./toast": "./src/toast.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/locale": "./src/lib/locale.tsx",
    "./lib/messages": "./src/lib/messages.ts"
  },
  "scripts": {
    "test": "bun --bun vp test run --exclude '**/*.int.test.ts' --passWithNoTests",
    "test:node": "vp test run --exclude '**/*.int.test.ts' --passWithNoTests",
    "typecheck": "tsc -p .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@commonair/contracts": "workspace:*",
    "@fontsource-variable/rubik": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
