{
  "name": "@commonair/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "bun --bun vp test run --exclude '**/*.int.test.ts' --passWithNoTests",
    "test:int": "bun --bun vp test run .int.test",
    "typecheck": "tsc -p .",
    "generate": "drizzle-kit generate",
    "migrate": "bun src/migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@commonair/config": "workspace:*",
    "@commonair/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
