    {
      "id": 9,
      "type": "timeseries",
      "title": "Replication: WAL age (needs pg_monitor)",
      "description": "Needs pg_monitor: the replay lag of standbys from pg_stat_replication, whose lag columns only pg_read_all_stats may read. Bundled installs have no standby, and a managed cluster's standby is the provider's, so this is usually empty; DigitalOcean's metrics endpoint (managed-db-metrics) reports replication lag instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
