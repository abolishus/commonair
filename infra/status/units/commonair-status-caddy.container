#
# Caddy: serves the rendered status page on STATUS_DOMAIN (caddy.env) with ACME.
[Unit]
Description=CommonAir status: Caddy
StartLimitIntervalSec=0

[Container]
Image=docker.io/library/caddy:2.11.7-alpine@sha256:24ec7b05bc532c7bb57f727030c5056e257ff7138b4b50460306819ff79362bd
ContainerName=commonair-status-caddy
Network=commonair-status.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
EnvironmentFile=/etc/commonair-status/caddy.env
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CAP_NET_BIND_SERVICE
Volume=/etc/commonair-status/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/var/lib/commonair-status/site:/srv/status:ro
Volume=commonair-status-caddy.volume:/data
# Caddy's autosaved config; nothing in it outlives a restart.
Tmpfs=/config

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
