#
# Weekly. Enabled at install for an external Postgres; with the bundled one, the first
# successful `selfhost.sh backup --drill` enables it.
[Unit]
Description=Weekly CommonAir restore drill (logical dump)

[Timer]
# Sunday, after the night's dump.
OnCalendar=Sun *-*-* 05:00:00 UTC
RandomizedDelaySec=1h
Persistent=true
Unit=commonair-drill.service

[Install]
WantedBy=timers.target
