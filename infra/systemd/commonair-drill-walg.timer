#
# Weekly, with the bundled Postgres only (enabled at install).
[Unit]
Description=Weekly CommonAir restore drill (WAL-G)

[Timer]
# Saturday, after the night's base backup (03:00) and object copy (04:00). Not Sunday: the dump
# drill (commonair-drill.timer) holds the same lock then, and the second to start would fail.
OnCalendar=Sat *-*-* 05:00:00 UTC
RandomizedDelaySec=1h
Persistent=true
Unit=commonair-drill-walg.service

[Install]
WantedBy=timers.target
