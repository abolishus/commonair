[Unit]
Description=Daily CommonAir Postgres base backup

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=30m
# Runs at the next boot if the server was off at 03:00.
Persistent=true
Unit=commonair-backup.service

[Install]
WantedBy=timers.target
