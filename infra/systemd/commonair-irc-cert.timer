#
# Its service is generated by Quadlet from quadlet/commonair-irc-cert.container.
[Unit]
Description=Daily CommonAir IRC certificate sync

[Timer]
OnBootSec=5min
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
Unit=commonair-irc-cert.service

[Install]
WantedBy=timers.target
