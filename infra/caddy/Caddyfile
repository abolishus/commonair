#
# TLS termination for PUBLIC_HOSTNAME (Quadlet unit commonair-caddy, compose profile `tls`).
# The host must be reachable on 80/443 (see infra/README.md for rootless port options).
#
# Certificates (ADR 0023 §11), all from the instance env; no domain is written here:
#   TLS_MODE=acme (the default, also when unset or empty): publicly trusted certificates over
#     ACME. ACME_EMAIL (optional) gets expiry notices; ACME_CA (optional) overrides the
#     directory, e.g. a staging CA. Without it the issuer is Let's Encrypt.
#   TLS_MODE=internal: Caddy's own CA, for LAN and test hosts. Clients must trust its root,
#     which Caddy writes to /data/caddy/pki/authorities/local/root.crt in the
#     commonair-caddy-data volume (`selfhost.sh status` prints the host path).
#   Any other TLS_MODE fails to load ("File to import not found: tls-<mode>"), on purpose.
# Caddy substitutes {$VAR} before parsing, and an empty value leaves no token at all, so the
# optional values sit only where a missing argument is still valid.
#
# Public URLs this implies (selfhost.sh install writes them to the env file):
#   PUBLIC_URL=https://<host>  API_PUBLIC_URL=https://<host>  PLAYBACK_PUBLIC_URL=https://<host>
#   CHAT_PUBLIC_URL=wss://<host>/chat  P2P_TRACKER_URL=wss://<host>/tracker
#   MEDIA_PUBLIC_URL=https://<host>/media
#   INGEST_WHIP_PUBLIC_URL=https://<host>/live  INGEST_RTMP_PUBLIC_URL=rtmp://<host>/live
#   S3_PUBLIC_ENDPOINT=https://<host>  (presigned uploads and export downloads, ADR 0024)
# The bucket names come from S3_BUCKET_MEDIA and S3_BUCKET_EXPORTS (defaults as in .env.example).
#
# Listeners (CADDY_LISTEN): `ports` (the default, compose) binds :80 and :443 in the container.
# `systemd` (the Quadlet unit) serves the sockets commonair-caddy.socket passes in: fd/3 (80),
# fd/4 (443) and fdgram/5 (443/udp), opened in the host's network namespace, so each connection
# comes from the client's own address, IPv6 included. Any other value fails to load.
#
# Client addresses: no `trusted_proxies`. Nothing in front of Caddy forwards for clients, so a
# client's own X-Forwarded-For is never believed: Caddy sends the services the address it
# accepted the connection from, and they trust that header from Caddy alone (its fixed address
# in TRUSTED_PROXY_CIDRS). Under compose's port forwarding that address is an internal one.
{
	# `cert_issuer acme` without a directory URL is Let's Encrypt.
	cert_issuer acme {$ACME_CA}
}

# Snippets must precede the site that imports them.
(listen-ports) {
}
(listen-systemd) {
	bind fd/4 {
		protocols h1 h2
	}
	bind fdgram/5 {
		protocols h3
	}
}
(http-ports) {
}
# Port 80 from systemd: a redirect to HTTPS. ACME validates here (Caddy answers HTTP challenges
# on its HTTP servers before any route) or over TLS-ALPN on 443.
(http-systemd) {
	http:// {
		bind fd/3 {
			protocols h1
		}
		redir https://{host}{uri} 308
	}
}
import http-{$CADDY_LISTEN:ports}

# `tls [<email>] { … }`: the block keeps the directive valid when ACME_EMAIL is empty.
(tls-acme) {
	tls {$ACME_EMAIL} {
		protocols tls1.2
	}
}
# TLS_MODE set but empty.
(tls-) {
	import tls-acme
}
(tls-internal) {
	tls internal {
		protocols tls1.2
	}
}

{$PUBLIC_HOSTNAME:localhost} {
	import listen-{$CADDY_LISTEN:ports}
	import tls-{$TLS_MODE:acme}

	# Presigned object URLs (ADR 0024): https://<host>/<bucket>/<key>?X-Amz-…, forwarded to Garage
	# with the path and Host unchanged, because both are signed. Only these two shapes; any other
	# method, bucket, prefix or unsigned request on those paths falls through to the web app.
	@s3-upload {
		method PUT
		path /{$S3_BUCKET_MEDIA:commonair-media}/incoming/*
		# The prefix itself is no object, and `*` also matches an empty suffix.
		not path /{$S3_BUCKET_MEDIA:commonair-media}/incoming/
		query X-Amz-Signature=*
	}
	@s3-export {
		method GET HEAD
		path /{$S3_BUCKET_EXPORTS:commonair-exports}/*
		# The bucket root with a trailing slash would be a signed listing.
		not path /{$S3_BUCKET_EXPORTS:commonair-exports}/
		query X-Amz-Signature=*
	}
	# Object responses are passed through as stored: compressing would drop Content-Length and
	# change the ETag of a signed download (exports are zip already).
	@compressible not query X-Amz-Signature=*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Service-to-service endpoints are never reachable from outside.
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	# Browser uploads (avatars, banners, panels): at most the contract's 10 MB (10,000,000 bytes;
	# Caddy's MB is decimal, like the contract's limit).
	handle @s3-upload {
		request_body {
			max_size 10MB
		}
		reverse_proxy garage:3900
	}
	# Data export downloads.
	handle @s3-export {
		reverse_proxy garage:3900
	}

	# The embeddable player must be frameable by any site; everything else must not be.
	@embed path /embed /embed/*
	@framed not path /embed /embed/*
	header @embed ?Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors *"
	header @framed {
		?Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		?X-Frame-Options "DENY"
	}

	handle /api/* {
		reverse_proxy api:3001
	}
	handle /rpc/* {
		reverse_proxy api:3001
	}
	# Overlay alert stream (SSE, OVERLAY_EVENTS_PATH); the overlay pages under /overlay/* stay with web.
	handle /overlay/events {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	# Chat WebSocket: wss://<host>/chat → chat:3002/ws
	handle /chat {
		rewrite * /ws
		reverse_proxy chat:3002
	}

	handle /hls/* {
		reverse_proxy origin:3003
	}
	handle /relay-pull/* {
		reverse_proxy origin:3003
	}
	handle /cdn/* {
		reverse_proxy origin:3003
	}
	# Public media objects; the origin serves only the public key prefixes (ADR 0009).
	handle /media/* {
		reverse_proxy origin:3003
	}

	# WHIP signaling: live/<slug>/whip and the session URLs MediaMTX returns under it. Media
	# itself flows over ICE (UDP 8189), not through Caddy.
	@whip path_regexp ^/live/[a-z0-9_]+/whip(/[^/]+)?$
	handle @whip {
		reverse_proxy mediamtx:8889
	}

	handle_path /tracker* {
		reverse_proxy tracker:8000
	}

	handle {
		reverse_proxy web:3000
	}

	# No access log: it would record viewers' IP addresses (AGENTS.md: no PII in logs).
}
