# MediaMTX with our config baked in, for hosts that cannot bind-mount files (Railway; see
# .railway/railway.ts). Compose and Quadlet mount infra/mediamtx/mediamtx.yml instead.
# Build context is the repository root. MediaMTX is MIT (infra/image-licenses.json).
#
# Per-host settings come from the environment: MTX_AUTHHTTPADDRESS (auth hook URL),
# API_INTERNAL_URL (online/offline hooks) and INTERNAL_API_SECRET.

FROM docker.io/bluenviron/mediamtx:1.21.2-ffmpeg
COPY infra/mediamtx/mediamtx.yml /mediamtx.yml
