#
# stripe-mock, Stripe's own API mock (staging seed mode only, ADR 0040). selfhost.sh installs this
# unit only while `selfhost.sh seed-mode open` is in effect, and `seed-mode close` removes it: the
# API then talks to it instead of Stripe (PAYMENTS_PROVIDER=stripe, STRIPE_API_BASE=
# http://stripe-mock:12111). It publishes no port; only the API, the worker and the seed harness on
# the commonair network reach it. It holds no data: every response is generated.
[Unit]
Description=CommonAir stripe-mock (seed mode)
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0

[Container]
Image=docker.io/stripe/stripe-mock:v0.206.0@sha256:aeb96b83e87a893d2ac005e363ac01ffa6e59a5ad85b49c155dfc9129de02e78
ContainerName=commonair-stripe-mock
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=stripe-mock
# The same check as compose's: an authenticated list call answers.
HealthCmd=wget -q -O /dev/null --header 'Authorization: Bearer sk_test_123' http://127.0.0.1:12111/v1/customers
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
# Leaves the cgroup as the next start needs it: RestartMode=direct skips systemd's own cleanup
# (scripts/selfhost/cgroup-reset.sh says why).
ExecStopPost=-/bin/sh %h/commonair/scripts/selfhost/cgroup-reset.sh
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
