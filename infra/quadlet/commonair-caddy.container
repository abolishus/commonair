#
# Caddy TLS termination for PUBLIC_HOSTNAME (public: 80/443, see infra/README.md).
[Unit]
Description=CommonAir caddy
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0
Wants=commonair-web.service
After=commonair-web.service
Wants=commonair-api.service
After=commonair-api.service

[Container]
Image=docker.io/library/caddy:2.11.7-alpine@sha256:24ec7b05bc532c7bb57f727030c5056e257ff7138b4b50460306819ff79362bd
ContainerName=commonair-caddy
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=caddy
# Only the keys of commonair.env this unit needs, copied at every start (see the ExecStartPre=).
EnvironmentFile=%h/.config/commonair/unit-env/commonair-caddy.env
PublishPort=0.0.0.0:80:80
PublishPort=0.0.0.0:443:443
PublishPort=0.0.0.0:443:443/udp
Volume=%h/commonair/infra/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=commonair-caddy-data.volume:/data
Volume=commonair-caddy-config.volume:/config
HealthCmd=CMD wget -q -O /dev/null http://127.0.0.1:2019/config/
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-caddy.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-caddy.env
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
