#
# The private network every CommonAir container joins (compose's `default`).
[Network]
NetworkName=commonair
Subnet=10.89.42.0/24
# Containers get their addresses from the upper half. The lower half holds the two fixed
# addresses the services trust X-Forwarded-For from (TRUSTED_PROXY_CIDRS): Caddy 10.89.42.10
# and web 10.89.42.11 (its proxy to the API), which no other container can then take.
# Quadlet never changes an existing network: selfhost.sh re-creates it only while its lease
# range still covers .10/.11. Any other change here needs its own migration step there.
IPRange=10.89.42.128/25
