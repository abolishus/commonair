#
# PostgreSQL 17 + WAL-G (infra/postgres/Containerfile).
[Unit]
Description=CommonAir postgres
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0

[Container]
Image=localhost/commonair/postgres:latest
ContainerName=commonair-postgres
# Not the postmaster as PID 1: orphans (timed-out execs, abandoned archive commands) would be
# reaped by it and treated as crashed backends, resetting every connection.
RunInit=true
Network=commonair.network
NetworkAlias=postgres
# Only the keys of commonair.env this unit needs, copied at every start (see the ExecStartPre=).
EnvironmentFile=%h/.config/commonair/unit-env/commonair-postgres.env
Environment=POSTGRES_USER=commonair
Environment=POSTGRES_DB=commonair
Environment=WALG_S3_ENDPOINT=http://garage:3900
Environment=S3_REGION=garage
PublishPort=127.0.0.1:5432:5432
Volume=commonair-postgres-data.volume:/var/lib/postgresql/data
# Healthy = accepts connections and is out of recovery (infra/postgres/health.sh).
HealthCmd=CMD commonair-pg-health
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
# Until the startup check passes, Podman runs only it: the regular check above (and its kill)
# starts afterwards. A plain pg_isready check killed a WAL replay after a restore at about two
# minutes, and no retry count fixes that, since Podman counts failures, not progress. The
# startup script tracks replay progress itself and stops the server only when it is stuck: no
# progress for 10 min during replay, or not up within 2 min on a normal start (health.sh).
# Retries=0: Podman never restarts on startup failures; the script's stop plus Restart= below
# does, as a plain container exit (Quadlet HealthStartup* keys exist since Podman 4.5).
HealthStartupCmd=CMD commonair-pg-health --startup
HealthStartupInterval=10s
HealthStartupTimeout=5s
HealthStartupRetries=0
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-postgres.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-postgres.env
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
# A backstop only, should the health checks never run: health.sh bounds a stuck start, and a
# replay that is still advancing must not fail for taking long. Recovery keeps restartpoints,
# so even this restart resumes the replay rather than starting it over.
TimeoutStartSec=12h

[Install]
WantedBy=default.target
