#
# Valkey (ephemeral: presence, caches, pub/sub, queues).
[Unit]
Description=CommonAir valkey

[Container]
Image=ghcr.io/valkey-io/valkey:9.1.2-trixie@sha256:418652cfb58ef879d4978c33553735d7147016032d5aefaa14c828e611eb9dfd
ContainerName=commonair-valkey
Network=commonair.network
NetworkAlias=valkey
PublishPort=127.0.0.1:6379:6379
Exec=valkey-server --appendonly no --save ""
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
