#
# Tempo (traces).
[Unit]
Description=CommonAir tempo
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0

[Container]
Image=localhost/commonair/tempo:latest
ContainerName=commonair-tempo
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=tempo
Volume=%h/commonair/infra/tempo/tempo.yaml:/etc/tempo.yaml:ro,Z
Volume=commonair-tempo-data.volume:/var/tempo
Exec=-config.file=/etc/tempo.yaml
HealthCmd=/usr/local/bin/busybox wget -q -O /dev/null http://127.0.0.1:3200/ready
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
Restart=always
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
