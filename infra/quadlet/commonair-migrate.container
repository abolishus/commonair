#
# One-shot: migrations as the owner, then the least-privilege app role.
#
# Every unit that touches the schema has Requires= and After= on this one, so it runs to
# completion before any of them starts. Mind that a stop or restart of this unit propagates to
# all of them (Requires= semantics): `selfhost.sh upgrade` stops the stack, installs the new
# units, starts this unit on its own and only then the rest (ADR 0023 §9).
[Unit]
Description=CommonAir migrate
Requires=commonair-postgres.service
After=commonair-postgres.service
# Bounded retries (see [Service]): six attempts an hour, then the unit fails for good.
StartLimitIntervalSec=1h
StartLimitBurst=6

[Container]
Image=localhost/commonair/tools:latest
ContainerName=commonair-migrate
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=migrate
EnvironmentFile=%h/.config/commonair/commonair.env
Secret=commonair-owner-database-url,type=env,target=DATABASE_URL
Exec=sh -c "bun packages/db/src/migrate.ts && bun infra/postgres/apply-app-role.ts"

[Service]
Type=oneshot
RemainAfterExit=yes
# A transient failure (Postgres still in crash recovery after a reboot, a dropped connection)
# is retried. RestartMode=direct (systemd >= 254) restarts without passing through the failed
# state, so dependents are not failed with a dependency result, which their Restart=always
# never retries (ADR 0023 §10). StartLimitBurst bounds it: a real failure still fails.
Restart=on-failure
RestartMode=direct
RestartSec=10s
RestartSteps=3
RestartMaxDelaySec=1min
TimeoutStartSec=600

[Install]
WantedBy=default.target
