#
# One-shot: Garage layout, S3 key import, buckets (idempotent).
[Unit]
Description=CommonAir garage-init
Wants=commonair-garage.service
After=commonair-garage.service
# Bounded retries (see [Service]): six attempts an hour, then the unit fails for good.
StartLimitIntervalSec=1h
StartLimitBurst=6

[Container]
Image=localhost/commonair/tools:latest
ContainerName=commonair-garage-init
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=garage-init
# Only the keys of commonair.env this unit needs, copied at every start (see the ExecStartPre=).
EnvironmentFile=%h/.config/commonair/unit-env/commonair-garage-init.env
Environment=GARAGE_ADMIN_URL=http://garage:3903
Exec=bun infra/garage/bootstrap.ts

[Service]
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-garage-init.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-garage-init.env
Type=oneshot
RemainAfterExit=yes
# A transient failure (Garage still starting after a reboot, a dropped connection)
# is retried. RestartMode=direct (systemd >= 254) restarts without passing through the failed
# state, so dependents are not failed with a dependency result, which their Restart=always
# never retries (ADR 0023 §10). StartLimitBurst bounds it: a real failure still fails.
Restart=on-failure
RestartMode=direct
RestartSec=10s
RestartSteps=3
RestartMaxDelaySec=1min
TimeoutStartSec=600

[Install]
WantedBy=default.target
