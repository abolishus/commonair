#
# Garage S3 object storage (single node).
[Unit]
Description=CommonAir garage
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0

[Container]
Image=docker.io/dxflrs/garage:v2.4.1@sha256:9c96caa2612d3411acc5b0e6701fb238dbfba33e533a6d7d3d811a4b12d0d020
ContainerName=commonair-garage
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=garage
# Only the keys of commonair.env this unit needs, copied at every start (see the ExecStartPre=).
EnvironmentFile=%h/.config/commonair/unit-env/commonair-garage.env
# Loopback only, for the off-host object copy (rclone, docs/self-hosting/backups.md). S3 signs
# every request, so a local process still needs a key.
PublishPort=127.0.0.1:3900:3900
Volume=%h/commonair/infra/garage/garage.toml:/etc/garage.toml:ro,Z
Volume=commonair-garage-meta.volume:/var/lib/garage/meta
Volume=commonair-garage-data.volume:/var/lib/garage/data
HealthCmd=CMD /garage status
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
# Leaves the cgroup as the next start needs it: RestartMode=direct skips systemd's own cleanup
# (scripts/selfhost/cgroup-reset.sh says why).
ExecStopPost=-/bin/sh %h/commonair/scripts/selfhost/cgroup-reset.sh
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-garage.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-garage.env
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
