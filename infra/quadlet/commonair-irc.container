# SPDX-FileCopyrightText: 2026 CommonAir contributors
# SPDX-License-Identifier: CC0-1.0
#
# Twitch-compatible IRC gateway.
[Unit]
Description=CommonAir irc
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0
Requires=commonair-migrate.service
After=commonair-migrate.service
Requires=commonair-garage-init.service
After=commonair-garage-init.service
Wants=commonair-valkey.service
After=commonair-valkey.service
Wants=commonair-otel-collector.service
After=commonair-otel-collector.service
Wants=commonair-chat.service
After=commonair-chat.service

[Container]
Image=localhost/commonair/irc:latest
ContainerName=commonair-irc
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=irc
# Only the keys of commonair.env this unit needs, copied at every start (see the ExecStartPre=).
EnvironmentFile=%h/.config/commonair/unit-env/commonair-irc.env
Environment=S3_ENDPOINT=http://garage:3900
Environment=S3_REGION=garage
Environment=S3_FORCE_PATH_STYLE=true
Environment=MEDIAMTX_API_URL=http://mediamtx:9997
Environment=MEDIAMTX_HLS_URL=http://mediamtx:8888
Environment=MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
Environment=API_INTERNAL_URL=http://api:3001
Environment=CHAT_INTERNAL_URL=ws://chat:3002/ws
Environment=ORIGIN_INTERNAL_URL=http://origin:3003
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# X-Forwarded-For is believed only from Caddy, at its fixed address (commonair.network).
Environment=TRUSTED_PROXY_CIDRS=10.89.42.10/32
Environment=WEB_PORT=3000
Environment=API_PORT=3001
Environment=CHAT_PORT=3002
Environment=ORIGIN_PORT=3003
Environment=MEDIA_PORT=3004
Environment=WORKER_PORT=3005
Environment=TRACKER_PORT=8000
Environment=IRC_PORT=6667
Environment=IRC_TLS_PORT=6697
Environment=IRC_WS_PORT=6680
Environment=IRC_HEALTH_PORT=6681
Environment=OTEL_SERVICE_NAME=irc
Environment=S3_EVIDENCE_ACCESS_KEY_ID=
Environment=S3_EVIDENCE_SECRET_ACCESS_KEY=
Environment=EVIDENCE_PRIVATE_KEY=
Environment=ONNXRUNTIME_NODE_INSTALL=skip
Secret=commonair-database-url,type=env,target=DATABASE_URL
# Production refuses to start without a certificate. commonair-irc-cert.service copies Caddy's
# certificate for IRC_PUBLIC_HOST here and restarts this unit when it renews.
Environment=IRC_TLS_CERT_FILE=/run/commonair/irc-tls/tls.crt
Environment=IRC_TLS_KEY_FILE=/run/commonair/irc-tls/tls.key
# Shared label (z, not Z): commonair-irc-cert.container writes the same directory.
Volume=%h/.config/commonair/irc-tls:/run/commonair/irc-tls:ro,z
# Raw IRC clients connect directly (IRC over WebSocket, 6680, is not published until it has a
# TLS route). No host address: Podman then listens on IPv6 and IPv4, or IPv4 alone on a host
# without IPv6. Rootless Podman forwards these through rootlessport, so IRC sees every client
# at one internal address and its per-address limits count all clients together; systemd
# socket activation (as Caddy has) needs IRC to accept inherited sockets (infra/README.md).
PublishPort=6667:6667
PublishPort=6697:6697
HealthCmd=CMD bun /opt/commonair/healthcheck.ts
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
# Leaves the cgroup as the next start needs it: RestartMode=direct skips systemd's own cleanup
# (scripts/selfhost/cgroup-reset.sh says why).
ExecStopPost=-/bin/sh %h/commonair/scripts/selfhost/cgroup-reset.sh
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-irc.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-irc.env
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
