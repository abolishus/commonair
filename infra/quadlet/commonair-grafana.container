#
# Grafana OSS (provisioned datasources; admin password from the env file).
[Unit]
Description=CommonAir grafana
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0
Wants=commonair-prometheus.service
After=commonair-prometheus.service
Wants=commonair-loki.service
After=commonair-loki.service
Wants=commonair-tempo.service
After=commonair-tempo.service

[Container]
Image=docker.io/grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f
ContainerName=commonair-grafana
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=grafana
# Only the keys of commonair.env this unit needs, copied at every start (see the ExecStartPre=).
EnvironmentFile=%h/.config/commonair/unit-env/commonair-grafana.env
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
Environment=GF_NEWS_NEWS_FEED_ENABLED=false
Environment=GF_PLUGINS_PLUGIN_ADMIN_ENABLED=false
Secret=commonair-grafana-admin-password,type=env,target=GF_SECURITY_ADMIN_PASSWORD
PublishPort=127.0.0.1:3030:3000
Volume=%h/commonair/infra/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=%h/commonair/infra/grafana/dashboards:/var/lib/grafana/dashboards:ro,Z
Volume=commonair-grafana-data.volume:/var/lib/grafana
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/api/health
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-grafana.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-grafana.env
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
