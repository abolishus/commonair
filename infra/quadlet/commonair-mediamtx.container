#
# MediaMTX ingest (RTMP/WHIP) and LL-HLS.
[Unit]
Description=CommonAir mediamtx
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0

[Container]
Image=docker.io/bluenviron/mediamtx:1.21.2-ffmpeg@sha256:c0feb4acc548d5f410d57d9046f62dfa355e2abc4098f5243de9e86430c77a95
ContainerName=commonair-mediamtx
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=mediamtx
EnvironmentFile=%h/.config/commonair/commonair.env
# The online/offline hooks in mediamtx.yml post to $API_INTERNAL_URL.
Environment=API_INTERNAL_URL=http://api:3001
# Encoders reach RTMP and WebRTC ICE directly; WHIP signaling goes through Caddy (HTTPS).
# ICE candidates advertise 8189, so host and container port stay equal. Set the server's public
# address in the env file (MTX_WEBRTCADDITIONALHOSTS=<IPv4>,<IPv6>) or remote encoders get only
# the container's internal address (docs/deploy/hetzner.md).
PublishPort=0.0.0.0:1935:1935
PublishPort=127.0.0.1:8889:8889
PublishPort=0.0.0.0:8189:8189/udp
Volume=%h/commonair/infra/mediamtx/mediamtx.yml:/mediamtx.yml:ro,Z
HealthCmd=nc -z 127.0.0.1 1935
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# Dependents start only once this container reports healthy.
Notify=healthy

[Service]
Restart=always
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
