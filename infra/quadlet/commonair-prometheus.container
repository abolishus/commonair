# SPDX-License-Identifier: CC0-1.0
#
# Prometheus, with the recording rules and alerts of infra/prometheus/rules
# (docs/operators/monitoring.md).
[Unit]
Description=CommonAir prometheus
# Never give up on a crash loop: RestartSteps below throttles it instead (ADR 0023 §10).
StartLimitIntervalSec=0

[Container]
Image=quay.io/prometheus/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
ContainerName=commonair-prometheus
# catatonit as PID 1 reaps orphans and forwards signals (ADR 0023 §10).
RunInit=true
Network=commonair.network
NetworkAlias=prometheus
# Only the keys of commonair.env this unit needs (SLO_TARGET, EGRESS_BUDGET_GIB,
# LIVE_STREAMS_PER_HOST, MANAGED_DB_METRICS_*), copied at every start.
EnvironmentFile=%h/.config/commonair/unit-env/commonair-prometheus.env
# prometheus.yml, rules/ and start.sh, which renders those settings into rules (and the optional
# managed-db-metrics job) before it execs Prometheus. The optional job's password is a Podman
# secret an operator adds with a drop-in (docs/operators/monitoring.md); nothing here needs it.
Volume=%h/commonair/infra/prometheus:/etc/prometheus:ro,Z
Volume=commonair-prometheus-data.volume:/prometheus
Entrypoint=/bin/sh
# 35 days: the 7-day sustained peak looks back 8 days and the 30-day budget and egress 30.
Exec=/etc/prometheus/start.sh --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=35d
HealthCmd=CMD wget -q -O /dev/null http://127.0.0.1:9090/-/ready
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=30s
# An unhealthy container is killed, and Restart= below starts a fresh one.
HealthOnFailure=kill
# No Notify=healthy: optional observability is active once its container runs. Grafana
# orders After= it but must not wait for its health: one that never got healthy held it back
# for good, as RestartMode=direct keeps its start job open across restarts. What it sends
# before it listens fails and is retried. The health check still runs, and still kills it.

[Service]
# Leaves the cgroup as the next start needs it: RestartMode=direct skips systemd's own cleanup
# (scripts/selfhost/cgroup-reset.sh says why).
ExecStopPost=-/bin/sh %h/commonair/scripts/selfhost/cgroup-reset.sh
# Renders that env file from commonair.env, so an edit there applies on the next restart. It
# fails closed: an unreadable commonair.env leaves no env file, and the unit does not start.
ExecStartPre=/bin/sh %h/commonair/scripts/selfhost/render-env.sh %h/commonair/infra/selfhost/env/commonair-prometheus.keys %h/.config/commonair/commonair.env %h/.config/commonair/unit-env/commonair-prometheus.env
Restart=always
RestartMode=direct
RestartSec=5
# Back off 5 s → 5 min over ten consecutive restarts, so a crash loop is throttled.
RestartSteps=10
RestartMaxDelaySec=5min
TimeoutStartSec=300

[Install]
WantedBy=default.target
